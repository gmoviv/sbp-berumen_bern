{
  "name": "synthetic-persona-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "db:reset": "dotenv -e .env.local -- tsx scripts/db/reset.ts",
    "db:setup": "dotenv -e .env.local -- tsx scripts/db/schema.ts",
    "db:auth:setup": "dotenv -e .env.local -- tsx scripts/db/auth-schema.ts",
    "db:locale:migrate": "dotenv -e .env.local -- tsx scripts/db/locale-migration.ts",
    "db:migrate:personas": "dotenv -e .env.local -- tsx scripts/db/migrate-personas.ts",
    "db:usage-logs:setup": "dotenv -e .env.local -- tsx scripts/db/usage-logs.ts",
    "embed": "dotenv -e .env.local -- tsx scripts/db/embed.ts",
    "eval:scoring": "dotenv -e .env.local -- tsx scripts/eval/scoring.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.74",
    "@ai-sdk/react": "^2.0.104",
    "@auth/core": "^0.41.0",
    "@auth/pg-adapter": "^1.11.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "ai": "^5.0.104",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "lucide-react": "0.407.0",
    "mammoth": "^1.11.0",
    "next": "16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^5.21.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "thirty-two": "^1.0.2",
    "uuid": "^13.0.0",
    "zod": "^3.25.76"
