    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
